# ============================================================
# AI YouTube Story Generator - Environment Variables
# Copy this file to ".env" (same folder) and fill in real values.
# NEVER commit the real ".env" file to git or share it.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=n8n
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=n8n

# ---- n8n ----
N8N_HOST=localhost
GENERIC_TIMEZONE=America/Toronto

# The key n8n uses to encrypt saved credentials. On a fresh install, leave
# empty on first start, then copy the generated key from the container:
#   docker exec aiyt_n8n node -e "process.stdout.write(JSON.parse(require('fs').readFileSync('/home/node/.n8n/config','utf8')).encryptionKey)"
# NEVER change it once credentials exist - they become undecryptable.
N8N_ENCRYPTION_KEY=

# NOTE: n8n login is the OWNER ACCOUNT you create in the web UI on first
# start. (Old N8N_BASIC_AUTH_* variables were removed in n8n v1+ and do nothing.)

# ---- Added in later modules (placeholders for now) ----
# OPENAI_API_KEY=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# IMAGE_API_KEY=
