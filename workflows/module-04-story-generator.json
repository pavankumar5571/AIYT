    {
      "id": "build1",
      "name": "Build Gemini Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        0
      ],
      "parameters": {
        "jsCode": "const cfgRaw = $('Extract Config').first().json;\nconst config = cfgRaw.data ?? cfgRaw;\nconst logRaw = $('Extract Story Log').first().json;\nconst log = logRaw.data ?? logRaw;\nconst systemPrompt = $('Extract System Prompt').first().json.data;\nconst template = $('Extract User Template').first().json.data;\n\nconst used = log.used || [];\nconst recent = used.slice(-config.avoid_recent);\nconst avoidList = recent.length\n  ? recent.map(u => `- \"${u.title}\" (theme: ${u.theme})`).join('\\n')\n  : '- (none yet - this is the first story)';\n\nconst theme = config.themes[Math.floor(Math.random() * config.themes.length)];\n\nconst userPrompt = template\n  .replace(/{{THEME}}/g, theme)\n  .replace(/{{TARGET_WORDS}}/g, String(config.target_words))\n  .replace(/{{AUDIENCE_AGE}}/g, config.audience_age)\n  .replace(/{{AVOID_LIST}}/g, avoidList);\n\nconst responseSchema = {\n  type: 'OBJECT',\n  properties: {\n    title: { type: 'STRING' },\n    logline: { type: 'STRING' },\n    theme: { type: 'STRING' },\n    moral: { type: 'STRING' },\n    characters: {\n      type: 'ARRAY',\n      items: {\n        type: 'OBJECT',\n        properties: {\n          name: { type: 'STRING' },\n          description: { type: 'STRING' },\n          visual_description: { type: 'STRING' }\n        },\n        required: ['name', 'description', 'visual_description']\n      }\n    },\n    story_text: { type: 'STRING' }\n  },\n  required: ['title', 'logline', 'theme', 'moral', 'characters', 'story_text']\n};\n\nconst body = {\n  systemInstruction: { parts: [{ text: systemPrompt }] },\n  contents: [{ role: 'user', parts: [{ text: userPrompt }] }],\n  generationConfig: {\n    responseMimeType: 'application/json',\n    responseSchema,\n    temperature: 1.0,\n    maxOutputTokens: 32768\n  }\n};\n\nreturn [{ json: { theme, model: config.text_model, body } }];"
      }
    },
    {
      "id": "gemini1",
      "name": "Gemini Generate Story",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2000,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{ $json.model }}:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "googlePalmApi": {
          "id": "aiytGeminiCred001",
          "name": "Gemini - AIYT"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "parse1",
      "name": "Parse and Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        0
      ],
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst cfgRaw = $('Extract Config').first().json;\nconst cfg = cfgRaw.data ?? cfgRaw;\nconst logRaw = $('Extract Story Log').first().json;\nconst log = logRaw.data ?? logRaw;\nconst req = $('Build Gemini Request').first().json;\n\nconst text = (resp.candidates?.[0]?.content?.parts || []).map(p => p.text || '').join('');\nif (!text) throw new Error('Gemini returned no text. Raw: ' + JSON.stringify(resp).slice(0, 300));\n\nlet story;\ntry {\n  story = JSON.parse(text);\n} catch (e) {\n  throw new Error('Gemini did not return valid JSON. First 200 chars: ' + text.slice(0, 200));\n}\n\nfor (const f of ['title', 'logline', 'theme', 'moral', 'characters', 'story_text']) {\n  if (!story[f] || (Array.isArray(story[f]) && story[f].length === 0)) {\n    throw new Error('Story is missing required field: ' + f);\n  }\n}\n\nconst wordCount = story.story_text.trim().split(/\\s+/).length;\nif (wordCount < cfg.target_words * 0.6) {\n  throw new Error(`Story too short: ${wordCount} words (target ${cfg.target_words})`);\n}\n\nconst used = log.used || [];\nconst norm = s => s.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();\nif (used.some(u => norm(u.title) === norm(story.title))) {\n  throw new Error('Duplicate story title generated: ' + story.title);\n}\n\nconst now = new Date();\nconst date = now.toISOString().slice(0, 10);\nconst slug = norm(story.title).replace(/\\s+/g, '-').slice(0, 60);\nconst id = `${date}_${slug}`;\n\nconst storyRecord = {\n  id,\n  date,\n  generated_at: now.toISOString(),\n  model: req.model,\n  requested_theme: req.theme,\n  word_count: wordCount,\n  status: 'story_generated',\n  ...story\n};\n\nconst updatedLog = {\n  used: [...used, { id, date, title: story.title, theme: story.theme }]\n};\n\nreturn [{ json: {\n  story: storyRecord,\n  updatedLog,\n  file_path: `/data/output/stories/${id}.json`,\n  title: story.title,\n  word_count: wordCount\n} }];"
      }
    },
