    {
      "id": "pick1",
      "name": "Pick Latest Story",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 0],
      "parameters": {
        "jsCode": "const raw = $('Extract Story Log').first().json;\nconst log = raw.data ?? raw;\nconst used = log.used || [];\nif (!used.length) throw new Error('No stories in story-log.json. Run Module 4 first.');\nconst latest = used[used.length - 1];\nreturn [{ json: { story_id: latest.id, story_path: `/data/output/stories/${latest.id}.json` } }];"
      }
    },
    {
      "id": "readstory1",
      "name": "Read Story File",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [800, 0],
      "parameters": {
        "operation": "read",
        "fileSelector": "={{ $json.story_path }}",
        "options": {}
      }
    },
    {
      "id": "extstory1",
