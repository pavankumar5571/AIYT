    {
      "id": "extbible1",
      "name": "Extract Bible",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [1400, 0],
      "parameters": { "operation": "fromJson", "options": {} }
    },
    {
      "id": "resolve1",
      "name": "Resolve Characters",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1600, 0],
      "parameters": {
        "jsCode": "const storyRaw = $('Extract Story').first().json;\nconst story = storyRaw.data ?? storyRaw;\nconst bibleRaw = $('Extract Bible').first().json;\nconst bible = bibleRaw.data ?? bibleRaw;\n\nconst recurring = bible.recurring_characters || {};\nconst registry = bible.registry || {};\nconst norm = s => String(s).toLowerCase().trim();\n\nconst recurringByNorm = {};\nfor (const [k, v] of Object.entries(recurring)) recurringByNorm[norm(k)] = { key: k, ...v };\n\nconst changes = [];\nconst resolvedChars = (story.characters || []).map(ch => {\n  const key = norm(ch.name);\n  if (recurringByNorm[key]) {\n    const canon = recurringByNorm[key];\n    changes.push({ name: ch.name, action: 'recurring-locked' });\n    return { name: ch.name, description: canon.description ?? ch.description, visual_description: canon.visual_description };\n  }\n  if (registry[key]) {\n    const canon = registry[key];\n    registry[key] = { ...canon, times_seen: (canon.times_seen || 1) + 1, last_seen: story.id };\n    changes.push({ name: ch.name, action: 'registry-match', times_seen: registry[key].times_seen });\n    return { name: ch.name, description: canon.description ?? ch.description, visual_description: canon.visual_description };\n  }\n  registry[key] = { name: ch.name, description: ch.description, visual_description: ch.visual_description, first_seen: story.id, last_seen: story.id, times_seen: 1 };\n  changes.push({ name: ch.name, action: 'new-registered' });\n  return ch;\n});\n\nconst updatedStory = { ...story, characters: resolvedChars, character_memory: { resolved_at: new Date().toISOString(), changes } };\nconst updatedBible = { ...bible, recurring_characters: recurring, registry };\n\nreturn [{ json: {\n  updatedStory,\n  updatedBible,\n  story_path: `/data/output/stories/${story.id}.json`,\n  bible_path: '/data/prompts/character-bible.json',\n  story_id: story.id,\n  registry_size: Object.keys(registry).length,\n  summary: changes.map(c => `${c.name}: ${c.action}${c.times_seen ? ' (x' + c.times_seen + ')' : ''}`).join('  |  ')\n} }];"
      }
    },
    {
      "id": "storyobj1",
      "name": "Story Object",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1800, 0],
      "parameters": {
        "jsCode": "return [{ json: $('Resolve Characters').first().json.updatedStory }];"
      }
    },
