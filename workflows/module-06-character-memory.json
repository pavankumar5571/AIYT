        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "s1", "name": "story_id", "type": "string", "value": "={{ $('Resolve Characters').item.json.story_id }}" },
            { "id": "s2", "name": "resolution", "type": "string", "value": "={{ $('Resolve Characters').item.json.summary }}" },
            { "id": "s3", "name": "registry_size", "type": "number", "value": "={{ $('Resolve Characters').item.json.registry_size }}" }
          ]
        },
