    },
    {
      "id": "readlog1",
      "name": "Read Story Log",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        600,
        0
      ],
      "parameters": {
        "operation": "read",
        "fileSelector": "/data/logs/story-log.json",
        "options": {}
      }
    },
    {
      "id": "extlog1",
      "name": "Extract Story Log",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        800,
        0
      ],
      "parameters": {
        "operation": "fromJson",
        "options": {}
      }
    },
    {
      "id": "pick1",
      "name": "Pick Latest Story",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "jsCode": "const raw = $('Extract Story Log').first().json;\nconst log = raw.data ?? raw;\nconst used = log.used || [];\nif (!used.length) throw new Error('No stories in story-log.json. Run Module 4 first.');\nconst latest = used[used.length - 1];\nreturn [{ json: { story_id: latest.id, scenes_path: `/data/output/scenes/${latest.id}.json` } }];"
      }
    },
    {
      "id": "readscenes1",
      "name": "Read Scenes File",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "operation": "read",
        "fileSelector": "={{ $json.scenes_path }}",
        "options": {}
      }
    },
    {
      "id": "extscenes1",
      "name": "Extract Scenes",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        1400,
        0
      ],
      "parameters": {
        "operation": "fromJson",
        "options": {}
      }
    },
    {
      "id": "prep1",
      "name": "Prepare TTS Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        0
      ],
      "parameters": {
        "jsCode": "const cfgRaw = $('Extract TTS Config').first().json;\nconst cfg = cfgRaw.data ?? cfgRaw;\nconst scRaw = $('Extract Scenes').first().json;\nconst sc = scRaw.data ?? scRaw;\n\nconst model = cfg.tts_model;\nconst voice = cfg.voice_name || 'Kore';\nconst style = cfg.style_prompt || '';\nconst ext = cfg.output_ext || 'wav';\nconst rate = cfg.sample_rate || 24000;\nconst max = cfg.max_scenes || 0;\n\nlet scenes = sc.scenes || [];\nif (max > 0) scenes = scenes.slice(0, max);\nif (!scenes.length) throw new Error('No scenes found. Run Module 5 first.');\n\nreturn scenes.map(s => {\n  const num = String(s.scene_number).padStart(2, '0');\n  const audio_file = `${sc.story_id}_scene-${num}.${ext}`;\n  const text = (style ? style + ' ' : '') + s.narration;\n  const body = { contents: [{ parts: [{ text }] }], generationConfig: { responseModalities: ['AUDIO'], speechConfig: { voiceConfig: { prebuiltVoiceConfig: { voiceName: voice } } } } };\n  return { json: { story_id: sc.story_id, scene_number: s.scene_number, tts_model: model, sample_rate: rate, out_path: `/data/output/audio/${audio_file}`, audio_file, body } };\n});"
      }
    },
    {
      "id": "gentts1",
      "name": "Generate Speech",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1800,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{ $json.tts_model }}:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 120000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 8000
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 12000,
      "credentials": {
        "googlePalmApi": {
          "id": "aiytGeminiCred001",
          "name": "Gemini - AIYT"
        }
      }
    },
    {
      "id": "pcmwav1",
      "name": "PCM to WAV",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        0
      ],
      "parameters": {
        "jsCode": "const resp = $input.all();\nconst meta = $('Prepare TTS Items').all();\nreturn resp.map((r, i) => {\n  const m = meta[i].json;\n  const parts = r.json.candidates?.[0]?.content?.parts || [];\n  const part = parts.find(p => p.inlineData || p.inline_data);\n  const inline = part && (part.inlineData || part.inline_data);\n  if (!inline) throw new Error('No audio for scene ' + m.scene_number + '. Response: ' + JSON.stringify(r.json).slice(0, 200));\n  let rate = m.sample_rate || 24000;\n  const mm = /rate=(\\d+)/.exec(inline.mimeType || '');\n  if (mm) rate = parseInt(mm[1], 10);\n  const ch = 1, bps = 16;\n  const pcm = Buffer.from(inline.data, 'base64');\n  const dataLen = pcm.length;\n  const header = Buffer.alloc(44);\n  header.write('RIFF', 0, 'ascii');\n  header.writeUInt32LE(36 + dataLen, 4);\n  header.write('WAVE', 8, 'ascii');\n  header.write('fmt ', 12, 'ascii');\n  header.writeUInt32LE(16, 16);\n  header.writeUInt16LE(1, 20);\n  header.writeUInt16LE(ch, 22);\n  header.writeUInt32LE(rate, 24);\n  header.writeUInt32LE(rate * ch * (bps / 8), 28);\n  header.writeUInt16LE(ch * (bps / 8), 32);\n  header.writeUInt16LE(bps, 34);\n  header.write('data', 36, 'ascii');\n  header.writeUInt32LE(dataLen, 40);\n  const wav = Buffer.concat([header, pcm]);\n  const duration = Math.round((dataLen / (rate * ch * (bps / 8))) * 100) / 100;\n  return { json: { story_id: m.story_id, scene_number: m.scene_number, out_path: m.out_path, audio_file: m.audio_file, duration_seconds: duration, wavB64: wav.toString('base64') } };\n});"
      }
    },
    {
      "id": "tobin1",
      "name": "Base64 to Binary",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        2200,
        0
      ],
      "parameters": {
        "operation": "toBinary",
        "sourceProperty": "wavB64",
        "options": {
          "fileName": "={{ $('PCM to WAV').item.json.audio_file }}",
          "mimeType": "audio/wav"
        }
      }
    },
    {
      "id": "writeaudio1",
      "name": "Write Audio File",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        2400,
        0
      ],
      "parameters": {
        "operation": "write",
        "fileName": "={{ $('PCM to WAV').item.json.out_path }}",
        "dataPropertyName": "data",
        "options": {}
      }
    },
    {
      "id": "collect1",
      "name": "Collect Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2600,
        0
      ],
      "parameters": {
        "jsCode": "const items = $('PCM to WAV').all().map(i => i.json);\nconst first = items[0] || {};\nconst cfgRaw = $('Extract TTS Config').first().json;\nconst cfg = cfgRaw.data ?? cfgRaw;\nconst clips = items.map(i => ({ scene_number: i.scene_number, file: i.audio_file, duration_seconds: i.duration_seconds })).sort((a, b) => a.scene_number - b.scene_number);\nconst total = Math.round(clips.reduce((s, c) => s + c.duration_seconds, 0) * 100) / 100;\nconst manifest = { story_id: first.story_id, generated_at: new Date().toISOString(), tts_model: cfg.tts_model, voice: cfg.voice_name, clip_count: clips.length, total_audio_duration_seconds: total, clips };\nreturn [{ json: { manifest, manifest_path: `/data/output/audio/${first.story_id}_audio.json`, clip_count: clips.length, total_audio_duration_seconds: total, story_id: first.story_id } }];"
      }
    },
    {
      "id": "manobj1",
      "name": "Manifest Object",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2800,
        0
      ],
      "parameters": {
        "jsCode": "return [{ json: $('Collect Results').first().json.manifest }];"
      }
    },
    {
      "id": "manfile1",
      "name": "Manifest to File",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        3000,
        0
      ],
      "parameters": {
        "operation": "toJson",
        "mode": "each",
        "options": {
          "format": true
        }
      }
    },
    {
      "id": "writeman1",
      "name": "Write Manifest",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        3200,
        0
      ],
      "parameters": {
        "operation": "write",
        "fileName": "={{ $('Collect Results').item.json.manifest_path }}",
        "dataPropertyName": "data",
        "options": {}
      }
    },
    {
      "id": "summary1",
      "name": "Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        3400,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "s1",
              "name": "story_id",
              "type": "string",
              "value": "={{ $('Collect Results').item.json.story_id }}"
            },
            {
              "id": "s2",
              "name": "clips_generated",
              "type": "number",
              "value": "={{ $('Collect Results').item.json.clip_count }}"
            },
            {
              "id": "s3",
              "name": "total_audio_duration_seconds",
              "type": "number",
              "value": "={{ $('Collect Results').item.json.total_audio_duration_seconds }}"
            },
            {
              "id": "s4",
              "name": "manifest",
              "type": "string",
              "value": "={{ $('Collect Results').item.json.manifest_path }}"
            }
          ]
        },
        "options": {}
      }
    }
  ],
