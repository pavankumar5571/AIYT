# ===== Secrets - NEVER commit =====
.env
.secrets/
*_creds.json
*_creds_enc.json
_secrets.env
*.local.txt

# ===== Generated media (huge; regenerate, don't version) =====
output/
assets/
*.mp4
*.wav
*.mp3
*.jpg
*.jpeg
*.png

# ===== Backups =====
backups/

# ===== Runtime logs (keep ONLY the dedupe state) =====
logs/*
!logs/.gitkeep
!logs/story-log.json

# ===== Node / build junk =====
node_modules/
.next/
*.tsbuildinfo

# ===== OS noise =====
Thumbs.db
desktop.ini
.DS_Store

# ===== Asset Library — canonical reusable assets MUST be versioned =====
# (generate-once/reuse: the registry in prompts/ points at these PNGs, so they
#  have to survive fresh clones + CI runners, unlike the disposable output/.)
!assets/
!assets/library/
!assets/library/**

